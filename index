{id:7,type:"mc",level:"Mudah",indicator:"Mengenali kebiasaan bersih sebelum makan",picture:"🧼🙌",question:"Apa yang sebaiknya kita lakukan sebelum makan?",choices:[["A","🧼","Mencuci tangan"],["B","🏃","Berlari sambil makan"],["C","🧸","Menyimpan makanan di lantai"],["D","🎨","Menggambar di makanan"],],answer:"A",explanation:"Mencuci tangan dengan sabun membantu membersihkan kuman sebelum kita makan.",open:"Coba tunjukkan gerakan mencuci tangan.",openIndicator:"Anak memperagakan sebagian langkah mencuci tangan.",rubric:"Memperagakan gerakan mencuci tangan dengan upaya yang sesuai."},
{id:8,type:"mc",level:"Sedang",indicator:"Memilih makanan beragam",picture:"🥗🍚🐟",question:"Agar makan lebih beragam, pilihan mana yang baik untuk makan bersama?",choices:[["A","🍬🍬🍬","Permen saja"],["B","🍚🐟🥬","Nasi, ikan, dan sayur"],["C","🍟🍟🍟","Kentang goreng saja"],["D","🍪🍪🍪","Kue saja"],],answer:"B",explanation:"Makan beragam, misalnya nasi, lauk, dan sayur, membantu tubuh mendapat berbagai zat gizi.",open:"Sebutkan satu sayur yang kamu kenal.",openIndicator:"Anak menyebutkan atau menunjuk satu jenis sayur.",rubric:"Contoh sayur benar, misalnya bayam, wortel, atau kangkung."},
{id:9,type:"mc",level:"Sedang",indicator:"Mengenali kebersihan makanan",picture:"🍎",question:"Kamu ingin makan apel. Apa yang sebaiknya dilakukan terlebih dahulu?",choices:[["A","🪨","Menggosok apel ke tanah"],["B","🧼","Mencuci apel dengan air bersih"],["C","👟","Meletakkan apel di sepatu"],["D","🎨","Mewarnai apel dengan cat"],],answer:"B",explanation:"Buah perlu dicuci dengan air bersih sebelum dimakan. Minta bantuan orang dewasa jika diperlukan.",open:"Apa yang kamu lakukan jika makanan jatuh ke lantai?",openIndicator:"Anak menyampaikan bahwa makanan perlu dibersihkan/diganti dan meminta bantuan orang dewasa.",rubric:"Menunjukkan pemahaman dasar tentang kebersihan dan keamanan makanan."},
