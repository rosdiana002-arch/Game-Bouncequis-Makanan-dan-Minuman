function loadHistory(){try{history=JSON.parse(localStorage.getItem("bqa_history")||"[]")}catch(e){history=[]}}
function persistHistory(){try{localStorage.setItem("bqa_history",JSON.stringify(history))}catch(e){}}
function freshState(){return {answers:{},name:$("childName").value.trim(),notes:$("teacherNotes").value.trim(),started:new Date().toISOString()}}
function initGame(){state=freshState();$("questionBackdrop").classList.remove("show");$("resultBackdrop").classList.remove("show");createBalls();updateStats();$("nameStatus").textContent="Sesi siap dimainkan."; }
function createBalls(){const arena=$("arena");arena.innerHTML="";const w=$("arenaWrap").clientWidth||700,h=$("arenaWrap").clientHeight||420;state.balls=[];QUESTIONS.forEach((q,i)=>{let el=document.createElement("button");el.className="ball";el.type="button";el.setAttribute("aria-label","Bola "+q.id);el.innerHTML="<span>"+q.id+"</span>";el.style.background=COLORS[i%COLORS.length];el.addEventListener("click",()=>openQuestion(q.id));arena.appendChild(el);const size=58;state.balls.push({id:q.id,el,x:Math.random()*Math.max(1,w-size),y:Math.random()*Math.max(1,h-size-24),vx:(Math.random()*.8+.35)*(Math.random()<.5?-1:1),vy:(Math.random()*.8+.35)*(Math.random()<.5?-1:1),size});});resizeBalls();if(!raf)raf=requestAnimationFrame(animate);}
function resizeBalls(){if(!state||!state.balls)return;const w=$("arenaWrap").clientWidth,h=$("arenaWrap").clientHeight;state.balls.forEach(b=>{b.x=Math.min(b.x,Math.max(0,w-b.size));b.y=Math.min(b.y,Math.max(0,h-b.size-22));});}
function animate(t){raf=requestAnimationFrame(animate);if(!state||!state.balls)return;const dt=Math.min((t-(lastTime||t))/16.67,2);lastTime=t;const w=$("arenaWrap").clientWidth,h=$("arenaWrap").clientHeight;state.balls.forEach(b=>{if(state.answers[b.id])return;b.x+=b.vx*dt;b.y+=b.vy*dt;const maxX=Math.max(0,w-b.size),maxY=Math.max(0,h-b.size-22);if(b.x<=0||b.x>=maxX){b.vx*=-1;b.x=Math.max(0,Math.min(maxX,b.x));}if(b.y<=0||b.y>=maxY){b.vy*=-1;b.y=Math.max(0,Math.min(maxY,b.y));}b.el.style.transform=`translate(${b.x}px,${b.y}px)`;});}
function updateStats(){const done=Object.keys(state.answers).length;const correct=Object.values(state.answers).filter(a=>a.type==="mc"&&a.score===100).length;$("answered").textContent=done;$("correctCount").textContent=correct;$("progressText").textContent=done+" dari 15 soal selesai";$("progressFill").style.width=(done/15*100)+"%";state.balls?.forEach(b=>{const doneBall=!!state.answers[b.id];b.el.classList.toggle("done",doneBall);b.el.disabled=doneBall;if(doneBall)b.el.innerHTML="<span>"+b.id+"</span>";});}
function openQuestion(id){if(state.answers[id])return;const q=QUESTIONS[id-1];if(!q)return;$("modalTitle").textContent="🎈 Bola "+id+" dari 15";const c=$("questionContent");c.innerHTML="";const tag=document.createElement("span");tag.className="tag";tag.textContent=(q.type==="mc"?"PILIHAN BERGAMBAR":"JAWAB LISAN BERSAMA GURU")+" • "+q.level;c.appendChild(tag);const pic=document.createElement("div");pic.className="picture";pic.textContent=q.picture;c.appendChild(pic);const question=document.createElement("div");question.className="question";question.textContent=q.question;c.appendChild(question);const indicator=document.createElement("div");indicator.className="hint";indicator.textContent="Fokus belajar: "+q.indicator;c.appendChild(indicator);
 if(q.type==="mc"){const choices=document.createElement("div");choices.className="choices";q.choices.forEach(([letter,emoji,label])=>{const b=document.createElement("button");b.className="choice";b.innerHTML=`<span class="letter">${letter}</span><span style="font-size:25px">${emoji}</span><span>${label}</span>`;b.addEventListener("click",()=>answerMC(q,letter,choices));choices.appendChild(b)});c.appendChild(choices);
 const open=document.createElement("div");open.className="open-question";open.innerHTML="<b>Pertanyaan terbuka untuk guru:</b><br>"+q.open+"<br><span class='hint'>Indikator: "+q.openIndicator+"</span>";c.appendChild(open);
 }else{const open=document.createElement("div");open.className="open-question";open.innerHTML="<b>Pertanyaan untuk anak:</b><br>"+q.open+"<br><span class='hint'>Indikator jawaban: "+q.openIndicator+"</span>";c.appendChild(open);const speak=document.createElement("button");speak.className="secondary";speak.textContent="🔊 Bacakan pertanyaan";speak.addEventListener("click",()=>{if("speechSynthesis"in window){speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(q.question);u.lang="id-ID";speechSynthesis.speak(u)}else alert("Fitur suara tidak tersedia. Guru dapat membacakan pertanyaan.");});c.appendChild(speak);const notes=document.createElement("div");notes.className="field";notes.innerHTML="<label>Catatan jawaban/observasi guru</label><textarea id='oralNotes' placeholder='Catat kata-kata atau perilaku yang diamati...'></textarea>";c.appendChild(notes);const rubric=document.createElement("div");rubric.innerHTML="<b>Rubrik guru</b><p class='small'>"+q.rubric+"</p>";c.appendChild(rubric);const r=document.createElement("div");r.className="rubric";[["Sangat Tepat","100","green"],["Cukup Tepat","50","blue"],["Belum Tepat","0","pink"]].forEach(([label,score,cls])=>{const b=document.createElement("button");b.className=cls;b.textContent=label+" • "+score;b.addEventListener("click",()=>finishOral(q,Number(score)));r.appendChild(b)});c.appendChild(r);}
 $("questionBackdrop").classList.add("show");}
function answerMC(q,letter,choices){if(state.answers[q.id])return;const correct=letter===q.answer;[...choices.children].forEach(b=>{b.disabled=true;const l=b.querySelector(".letter").textContent;if(l===q.answer)b.classList.add("correct");if(l===letter&&!correct)b.classList.add("wrong")});const feedback=document.createElement("div");feedback.className="feedback show "+(correct?"good":"try");feedback.innerHTML="<b>"+(correct?"🌟 Hebat! Jawabanmu tepat!":"💛 Terima kasih sudah mencoba!")+"</b><br>"+q.explanation;choices.parentNode.appendChild(feedback);const done=document.createElement("button");done.className="green";done.style.marginTop="12px";done.textContent="Selesai";done.addEventListener("click",()=>{if(state.answers[q.id])return;state.answers[q.id]={type:"mc",choice:letter,score:correct?100:0,correct,notes:"",time:new Date().toISOString()};finishQuestion(q.id);});choices.parentNode.appendChild(done);}
function finishOral(q,score){if(state.answers[q.id])return;const notes=$("oralNotes")?.value.trim()||"";state.answers[q.id]={type:"oral",score,correct:null,choice:"",notes,time:new Date().toISOString()};const c=$("questionContent");c.innerHTML="<div class='picture'>"+(score===100?"🌟":score===50?"👍":"💛")+"</div><div class='question'>"+(score===100?"Hebat, terima kasih sudah bercerita!":score===50?"Bagus, kamu sudah mencoba menjawab!":"Terima kasih sudah berusaha. Kita bisa belajar bersama.")+"</div><p>"+q.openIndicator+"</p><p class='small'>Skor tercatat: "+score+" poin.</p>";const b=document.createElement("button");b.className="green";b.textContent="Selesai";b.addEventListener("click",()=>finishQuestion(q.id));c.appendChild(b);}
function finishQuestion(id){$("questionBackdrop").classList.remove("show");updateStats();if(Object.keys(state.answers).length===15)showResult();}
function scoreTotal(){return Object.values(state.answers).reduce((s,a)=>s+a.score,0)}
function showResult(){const total=scoreTotal(),score=Math.round(total/1500*100),mc=Object.values(state.answers).filter(a=>a.type==="mc"),correct=mc.filter(a=>a.correct).length,wrong=mc.length-correct,oral=Object.values(state.answers).filter(a=>a.type==="oral");$("resultContent").innerHTML=`<p class="small">${escapeHtml(state.name||"Anak")} • 15 soal selesai</p><div class="result-score">${score}</div><p><b>Nilai akhir dari 100</b></p><div class="open-question">📝 Jumlah soal: <b>15</b><br>✅ Pilihan ganda benar: <b>${correct}</b><br>↪️ Pilihan ganda salah: <b>${wrong}</b><br>🗣️ Ringkasan skor lisan: <b>${oral.reduce((s,a)=>s+a.score,0)} / 400</b><br>⭐ Total poin: <b>${total} / 1500</b></div><p class="small">Nilai merupakan ringkasan sesi. Gunakan catatan observasi dan pertimbangan profesional guru untuk menentukan tindak lanjut pembelajaran.</p><p><b>Catatan guru:</b> ${escapeHtml(state.notes||"Belum ada catatan umum.")}</p>`;$("resultBackdrop").classList.add("show");saveSession();}
function saveSession(){const answers=QUESTIONS.map(q=>({id:q.id,type:q.type,indicator:q.indicator,score:state.answers[q.id]?.score??null,correct:state.answers[q.id]?.correct??null,choice:state.answers[q.id]?.choice??"",notes:state.answers[q.id]?.notes??""}));const record={name:state.name||"Anak tanpa nama",date:new Date().toLocaleString("id-ID"),timestamp:new Date().toISOString(),score:Math.round(scoreTotal()/1500*100),total:scoreTotal(),notes:state.notes||"",answers};history.push(record);persistHistory();}
function openTeacher(){renderHistory();$("teacherBackdrop").classList.add("show")}
function renderHistory(){const completed=history.length;$("sessionSummary").textContent="Jumlah sesi tersimpan: "+completed;$("historyTable").innerHTML="";if(!completed){$("historyTable").innerHTML="<div class='empty'>Belum ada sesi tersimpan. Selesaikan satu sesi untuk melihat rekap.</div>";return;}const table=document.createElement("table");table.innerHTML="<thead><tr><th>Nama</th><th>Tanggal</th><th>Nilai</th><th>Total Poin</th><th>Catatan</th></tr></thead>";const tb=document.createElement("tbody");history.slice().reverse().forEach(r=>{const tr=document.createElement("tr");[r.name,r.date,r.score,r.total,r.notes||"—"].forEach(v=>{const td=document.createElement("td");td.textContent=v;tr.appendChild(td)});tb.appendChild(tr)});table.appendChild(tb);$("historyTable").appendChild(table);}
function exportCSV(){if(!history.length){alert("Belum ada rekap untuk diekspor.");return;}const rows=[["Nama","Tanggal","Nilai akhir","Total poin","Catatan umum",...QUESTIONS.map(q=>"Soal "+q.id+" skor"),...QUESTIONS.map(q=>"Soal "+q.id+" catatan")]];history.forEach(r=>rows.push([r.name,r.date,r.score,r.total,r.notes,...r.answers.map(a=>a.score??""),...r.answers.map(a=>a.notes||"")]));const csv=rows.map(row=>row.map(v=>'"'+String(v??"").replace(/"/g,'""')+'"').join(",")).join("\r\n");downloadFile("rekap_bouncequiz_ai.csv","\ufeff"+csv,"text/csv;charset=utf-8");}
function downloadFile(name,content,type){const blob=new Blob([content],{type});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function startNew(){if(Object.keys(state.answers).length>0&&!confirm("Mulai sesi baru? Hasil sesi yang sudah selesai akan tetap tersimpan. Sesi yang belum selesai tidak disimpan sebagai hasil akhir."))return;initGame();}
$("closeQuestion").addEventListener("click",()=>$("questionBackdrop").classList.remove("show"));$("closeTeacher").addEventListener("click",()=>$("teacherBackdrop").classList.remove("show"));$("closeResult").addEventListener("click",()=>$("resultBackdrop").classList.remove("show"));$("teacherBtn").addEventListener("click",openTeacher);$("newSessionBtn").addEventListener("click",startNew);$("playAgainBtn").addEventListener("click",()=>{ $("resultBackdrop").classList.remove("show");initGame();});$("viewReportBtn").addEventListener("click",()=>{$("resultBackdrop").classList.remove("show");openTeacher();});$("exportBtn").addEventListener("click",exportCSV);$("exportResultBtn").addEventListener("click",exportCSV);$("clearHistoryBtn").addEventListener("click",()=>{if(confirm("Hapus semua riwayat asesmen yang tersimpan di browser ini?")){history=[];persistHistory();renderHistory();}});$("saveNameBtn").addEventListener("click",()=>{state.name=$("childName").value.trim();state.notes=$("teacherNotes").value.trim();$("nameStatus").textContent="Identitas dan catatan sesi diperbarui.";});
$("questionBackdrop").addEventListener("click",e=>{if(e.target===$("questionBackdrop"))$("questionBackdrop").classList.remove("show")});$("teacherBackdrop").addEventListener("click",e=>{if(e.target===$("teacherBackdrop"))$("teacherBackdrop").classList.remove("show")});$("resultBackdrop").addEventListener("click",e=>{if(e.target===$("resultBackdrop"))$("resultBackdrop").classList.remove("show")});window.addEventListener("resize",resizeBalls);document.addEventListener("keydown",e=>{if(e.key==="Escape")document.querySelectorAll(".modal-backdrop.show").forEach(m=>m.classList.remove("show"));});
function validateData(){if(QUESTIONS.length!==15)throw Error("Jumlah soal harus 15");const ids=new Set(QUESTIONS.map(q=>q.id));if(ids.size!==15)throw Error("ID soal duplikat");if(QUESTIONS.filter(q=>q.type==="mc").length!==11||QUESTIONS.filter(q=>q.type==="oral").length!==4)throw Error("Distribusi soal tidak sesuai");QUESTIONS.forEach(q=>{if(!q.question||!q.open||!q.openIndicator||!q.rubric)throw Error("Data soal tidak lengkap: "+q.id);if(q.type==="mc"&&(q.choices.length!==4||q.choices.filter(c=>c[0]===q.answer).length!==1))throw Error("Pilihan/kunci tidak valid: "+q.id)});}
loadHistory();try{validateData();initGame()}catch(e){document.body.innerHTML="<main><h1>Terjadi masalah saat memuat game</h1><p>"+escapeHtml(e.message)+"</p></main>";}
</script>
</body>
